{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,

  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/nosotros.html", "destination": "/nosotros", "permanent": true },
    { "source": "/yo.html", "destination": "/yo", "permanent": true },
    { "source": "/servicios.html", "destination": "/servicios", "permanent": true },
    { "source": "/portfolio.html", "destination": "/portfolio", "permanent": true },
    { "source": "/contacto.html", "destination": "/contacto", "permanent": true },
    { "source": "/privacidad.html", "destination": "/privacidad", "permanent": true },
    { "source": "/terminos.html", "destination": "/terminos", "permanent": true },
    { "source": "/404.html", "destination": "/", "permanent": true },
    { "source": "/css/:path*", "destination": "/", "permanent": true },
    { "source": "/js/:path*", "destination": "/", "permanent": true }
  ],

  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/nosotros", "destination": "/index.html" },
    { "source": "/yo", "destination": "/index.html" },
    { "source": "/servicios", "destination": "/index.html" },
    { "source": "/portfolio", "destination": "/index.html" },
    { "source": "/contacto", "destination": "/index.html" },
    { "source": "/privacidad", "destination": "/index.html" },
    { "source": "/terminos", "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/404.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/((?!assets/|404\\.html$).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    }
  ]
}
